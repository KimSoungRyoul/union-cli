{
  "name": "union-cli",
  "version": "0.1.0",
  "description": "YAML로 선언하고, build하면 통합 CLI가 만들어지는 프레임워크",
  "type": "module",
  "workspaces": ["packages/*"],
  "bin": {
    "union-cli": "./bin/run.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/bin",
    "/dist",
    "/bridge",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "./bin/dev.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude 'test/e2e/**'",
    "test:e2e": "vitest run test/e2e/",
    "format": "prettier --write src/ test/",
    "format:check": "prettier --check src/ test/",
    "lint": "eslint src/ test/",
    "lint:types": "tsc --noEmit",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "oclif manifest",
    "prepare": "husky"
  },
  "oclif": {
    "bin": "union-cli",
    "dirname": "union-cli",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "hooks": {
      "init": "./dist/hooks/init.js",
      "command_not_found": "./dist/hooks/command-not-found.js"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-version"
    ],
    "topicSeparator": " ",
    "topics": {
      "auth": {
        "description": "인증 관리"
      },
      "config": {
        "description": "설정 관리"
      },
      "plugin": {
        "description": "플러그인 관리"
      },
      "completion": {
        "description": "셸 자동완성"
      }
    }
  },
  "dependencies": {
    "@oclif/core": "^4.2.8",
    "@oclif/plugin-help": "^6.2.27",
    "@oclif/plugin-version": "^2.2.41",
    "ajv": "^8.17.1",
    "undici": "^6.21.0",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oclif/test": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oclif": "^4.17.38",
    "prettier": "^3.4.2",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.ts": "eslint --fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT"
}
